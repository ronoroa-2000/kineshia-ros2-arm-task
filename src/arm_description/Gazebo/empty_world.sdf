<?xml version="1.0" ?>
<!--
  Empty world with a large table. The robot is spawned on the table top.
  Table top surface is at z = 0.75. It spans x in [-7, 7], y in [-1, 7],
  which covers the arm's full reach (6.5 m) over the y >= 0 half plane.
-->
<sdf version="1.9">
  <world name="empty_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <gravity>0 0 -9.81</gravity>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Table: top surface at z = 0.75 -->
    <model name="table">
      <static>true</static>
      <pose>0 3 0 0 0 0</pose>
      <link name="link">
        <!-- Tabletop 14 x 8 x 0.1, centre z = 0.70 -->
        <collision name="top_collision">
          <pose>0 0 0.70 0 0 0</pose>
          <geometry><box><size>14 8 0.1</size></box></geometry>
        </collision>
        <visual name="top_visual">
          <pose>0 0 0.70 0 0 0</pose>
          <geometry><box><size>14 8 0.1</size></box></geometry>
          <material>
            <ambient>0.55 0.38 0.2 1</ambient>
            <diffuse>0.55 0.38 0.2 1</diffuse>
          </material>
        </visual>

        <!-- Four legs 0.15 x 0.15 x 0.65 -->
        <collision name="leg1_collision">
          <pose>6.8 3.8 0.325 0 0 0</pose>
          <geometry><box><size>0.15 0.15 0.65</size></box></geometry>
        </collision>
        <visual name="leg1_visual">
          <pose>6.8 3.8 0.325 0 0 0</pose>
          <geometry><box><size>0.15 0.15 0.65</size></box></geometry>
          <material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.3 0.2 0.1 1</diffuse></material>
        </visual>
        <collision name="leg2_collision">
          <pose>-6.8 3.8 0.325 0 0 0</pose>
          <geometry><box><size>0.15 0.15 0.65</size></box></geometry>
        </collision>
        <visual name="leg2_visual">
          <pose>-6.8 3.8 0.325 0 0 0</pose>
          <geometry><box><size>0.15 0.15 0.65</size></box></geometry>
          <material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.3 0.2 0.1 1</diffuse></material>
        </visual>
        <collision name="leg3_collision">
          <pose>6.8 -3.8 0.325 0 0 0</pose>
          <geometry><box><size>0.15 0.15 0.65</size></box></geometry>
        </collision>
        <visual name="leg3_visual">
          <pose>6.8 -3.8 0.325 0 0 0</pose>
          <geometry><box><size>0.15 0.15 0.65</size></box></geometry>
          <material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.3 0.2 0.1 1</diffuse></material>
        </visual>
        <collision name="leg4_collision">
          <pose>-6.8 -3.8 0.325 0 0 0</pose>
          <geometry><box><size>0.15 0.15 0.65</size></box></geometry>
        </collision>
        <visual name="leg4_visual">
          <pose>-6.8 -3.8 0.325 0 0 0</pose>
          <geometry><box><size>0.15 0.15 0.65</size></box></geometry>
          <material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.3 0.2 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
